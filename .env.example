TELEGRAM_TOKEN=
# Required owner-supplied negative Telegram group/supergroup ID
BOUND_COMMUNITY_ID=-1000000000000
# Optional startup identity check and display reference
BOUND_COMMUNITY_USERNAME=
BOUND_COMMUNITY_URL=
# Legacy alias accepted for migration only; prefer BOUND_COMMUNITY_ID
COMMUNITY_CHAT_ID=
LOG_TOPIC_ID=
ADMIN_IDS=
OPENROUTER_API_KEY=
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: one model for everything (chat + image reading). Paid ids must be in PAID_MODELS.
# Example: CHAT_MODEL=deepseek/deepseek-v4.1-flash  VISION_MODEL=deepseek/deepseek-v4.1-flash
# (the free dots vision model is slow and returns upstream 400s for Arabic images; the paid
#  DeepSeek flash reads Arabic correctly at ~$0.0005 per page.)
VISION_MODEL=dots-studio/dots-3-note-preview:free
PAID_MODELS=
AUDIO_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Optional: Groq free-tier Whisper voice transcription (tried first when set; OpenRouter audio models are the fallback)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq free-tier chat model
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# true = Groq answers text-only turns first (free); false = configured model first, Groq last
GROQ_CHAT_FIRST=true
# OpenRouter :free fallbacks tried (in order) when the primary model fails
CHAT_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free
VISION_FALLBACK_MODELS=google/gemma-4-31b-it:free
# Optional paid image-generation fallback (illustrations use free Pollinations first)
IMAGE_MODEL=
MAX_MEDIA_BYTES=18874368
MAX_TEXT_CHARS=12000
DRY_RUN=true
RATE_LIMIT_RPM=8
DAILY_CAP=200
DATA_DIR=data
WARNING_DELETE_SECONDS=60
WELCOME_ENABLED=true
WELCOME_DELETE_SECONDS=60
MUTE_WARNING_SECONDS=15
SOURCE_IMAGE_LIMIT=30
SOURCE_WEB_IMAGE_LIMIT=4
# Page cap for non-admin PDF/source jobs (0 disables; admins keep the 200-page cap)
PUBLIC_SOURCE_PAGES=10
STRIKE_DECAY_DAYS=30
# Public DM intro + fair-use quota (non-admin users; admins have no request limits)
REPO_URL=
# Rolling hourly limit by default; 0 disables a window (DM_QUOTA_5H/24H optional)
DM_QUOTA_1H=10
DM_QUOTA_5H=0
DM_QUOTA_24H=0
ADMIN_CACHE_SECONDS=900
CONTEXT_TOKEN_BUDGET=24000
AUDIT_RETENTION_DAYS=90
