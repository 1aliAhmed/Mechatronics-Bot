[Unit]
Description=Megatronics Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=megatronics
Group=megatronics
WorkingDirectory=/opt/megatronics
EnvironmentFile=/opt/megatronics/.env
ExecStart=/opt/megatronics/.venv/bin/python -m app.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/megatronics/data

[Install]
WantedBy=multi-user.target
